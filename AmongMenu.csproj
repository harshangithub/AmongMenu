<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AmongMenu</AssemblyName>
    <RootNamespace>AmongMenu</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>1.0.0</Version>
    <Copyright>MIT</Copyright>
    <Description>Among Us overlay – shows impostors, crewmates, distance and real-time tracers.</Description>
    <WarningsAsErrors>CS8600;CS8601;CS8602;CS8603</WarningsAsErrors>
  </PropertyGroup>

  <!-- Optional icon – place a 256×256 .ico file at Resources\icon.ico to use it -->
  <ItemGroup Condition="Exists('Resources\icon.ico')">
    <Content Include="Resources\icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
